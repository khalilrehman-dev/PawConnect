<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Paw.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/paw_space_sm">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/paw_space_md">


        <!-- ================================================= -->
        <!-- Patient main information                          -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPatientPetImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@color/paw_surface_variant"
                android:contentDescription="Patient photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pet_placeholder"
                app:shapeAppearanceOverlay="@style/PawConnectRoundedMediumShape" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_md"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvPetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Pet Name"
                    android:textAppearance="@style/Paw.Text.Title" />


                <TextView
                    android:id="@+id/tvOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Owner: Name"
                    android:textAppearance="@style/Paw.Text.BodySecondary" />


                <TextView
                    android:id="@+id/tvPatientPetDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Dog • Labrador • 3 yrs • Male"
                    android:textAppearance="@style/Paw.Text.Caption" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Divider                                           -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/paw_space_md"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:background="@color/paw_divider" />


        <!-- ================================================= -->
        <!-- Visit information                                 -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvPatientVisitLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upcoming visit"
            android:textColor="@color/paw_primary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:orientation="horizontal">


            <!-- Date -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="18/8/2026"
                    android:textAppearance="@style/Paw.Text.Body" />

            </LinearLayout>


            <!-- Time -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="3:30 PM"
                    android:textAppearance="@style/Paw.Text.Body" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>