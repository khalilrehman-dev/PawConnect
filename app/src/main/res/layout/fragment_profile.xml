<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <!-- Header -->

    <TextView
        android:id="@+id/tvProfileScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xl"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Profile"
        android:textAppearance="@style/Paw.Text.Headline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvProfileScreenSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xxs"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Manage your PawConnect account."
        android:textAppearance="@style/Paw.Text.BodySecondary"
        app:layout_constraintTop_toBottomOf="@id/tvProfileScreenTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Main Profile Content -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/paw_space_md"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvProfileScreenSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/paw_screen_horizontal"
            android:paddingEnd="@dimen/paw_screen_horizontal"
            android:paddingBottom="@dimen/paw_space_2xl">


            <!-- Profile Header -->

            <com.google.android.material.card.MaterialCardView
                style="@style/Paw.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/paw_space_xl">


                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfileImage"
                        android:layout_width="@dimen/paw_avatar_profile"
                        android:layout_height="@dimen/paw_avatar_profile"
                        android:background="@color/paw_surface_variant"
                        android:contentDescription="Profile photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:shapeAppearanceOverlay="@style/PawConnectCircleShape" />


                    <TextView
                        android:id="@+id/tvChangePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_sm"
                        android:padding="@dimen/paw_space_xs"
                        android:text="Change Photo"
                        android:textColor="@color/paw_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />


                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_md"
                        android:gravity="center"
                        android:text="Name"
                        android:textAlignment="center"
                        android:textAppearance="@style/Paw.Text.TitleLarge" />


                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_xxs"
                        android:gravity="center"
                        android:text="Veterinarian"
                        android:textAlignment="center"
                        android:textColor="@color/paw_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Account Information -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:text="Account information"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutView"
                style="@style/Paw.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/paw_space_lg">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textAppearance="@style/Paw.Text.Caption" />


                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_xxs"
                        android:text="email@example.com"
                        android:textAppearance="@style/Paw.Text.Body" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/paw_space_md"
                        android:layout_marginBottom="@dimen/paw_space_md"
                        android:background="@color/paw_divider" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone"
                        android:textAppearance="@style/Paw.Text.Caption" />


                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_xxs"
                        android:text="Not provided"
                        android:textAppearance="@style/Paw.Text.Body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Edit Form -->

            <LinearLayout
                android:id="@+id/layoutEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Paw.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name">


                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext" />

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Paw.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_sm"
                    android:hint="Phone Number">


                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:imeOptions="actionDone" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- Professional Vet Profile -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVetProfessionalProfile"
                style="@style/Paw.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:text="Professional Vet Profile"
                android:visibility="gone" />


            <!-- Profile Actions -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Paw.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="Edit Profile" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Paw.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="Save Changes"
                android:visibility="gone" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEdit"
                style="@style/Paw.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="Cancel"
                android:visibility="gone" />


            <!-- Sign Out -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Paw.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:text="Sign Out"
                android:textColor="@color/paw_error"
                app:strokeColor="@color/paw_error" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- Loading -->

    <LinearLayout
        android:id="@+id/layoutProfileLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvProfileScreenSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            app:indicatorColor="@color/paw_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="Loading profile..."
            android:textAppearance="@style/Paw.Text.BodySecondary" />

    </LinearLayout>


    <!-- Error -->

    <LinearLayout
        android:id="@+id/layoutProfileError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvProfileScreenSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load profile"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvProfileError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:text="Please try again."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryProfile"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>