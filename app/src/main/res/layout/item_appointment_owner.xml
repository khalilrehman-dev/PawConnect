<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Paw.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/paw_space_sm">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/paw_space_lg">


        <!-- Vet + Status -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvVetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dr. Name"
                    android:textAppearance="@style/Paw.Text.Title" />


                <TextView
                    android:id="@+id/tvClinic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Clinic"
                    android:textAppearance="@style/Paw.Text.BodySecondary" />

            </LinearLayout>


            <com.google.android.material.chip.Chip
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_sm"
                android:clickable="false"
                android:focusable="false"
                android:text="Pending"
                android:textSize="12sp"
                app:chipMinHeight="32dp" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/paw_space_md"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:background="@color/paw_divider" />


        <!-- Pet -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Pet"
                android:src="@drawable/ic_nav_pets"
                app:tint="@color/paw_primary" />


            <TextView
                android:id="@+id/tvPetName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_sm"
                android:layout_weight="1"
                android:text="Pet"
                android:textAppearance="@style/Paw.Text.Body" />

        </LinearLayout>


        <!-- Date and Time -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="18/8/2026"
                    android:textAppearance="@style/Paw.Text.Body" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="3:30 PM"
                    android:textAppearance="@style/Paw.Text.Body" />

            </LinearLayout>

        </LinearLayout>


        <!-- Note -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppointmentNote"
            style="@style/Paw.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md">


            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/paw_space_sm"
                android:text="Appointment note"
                android:textAppearance="@style/Paw.Text.BodySecondary" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Cancel -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAppointment"
            style="@style/Paw.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="Cancel appointment"
            android:textColor="@color/paw_error"
            android:visibility="gone"
            app:strokeColor="@color/paw_error" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>