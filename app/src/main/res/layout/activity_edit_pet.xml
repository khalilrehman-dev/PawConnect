<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEditPet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background"
    android:focusable="true"
    android:focusableInTouchMode="true">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditPet"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/paw_background"
        app:title="Edit Pet"
        app:titleTextColor="@color/paw_text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Edit Form                                             -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentEditPet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditPet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/paw_screen_horizontal"
            android:paddingTop="@dimen/paw_space_lg"
            android:paddingEnd="@dimen/paw_screen_horizontal"
            android:paddingBottom="@dimen/paw_space_2xl">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update pet profile"
                android:textAppearance="@style/Paw.Text.Headline" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xxs"
                android:text="Keep your pet's information accurate and up to date."
                android:textAppearance="@style/Paw.Text.BodySecondary" />


            <!-- Photo -->

            <com.google.android.material.card.MaterialCardView
                style="@style/Paw.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_lg">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/paw_space_xl">


                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPetPhoto"
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:background="@color/paw_surface_variant"
                        android:contentDescription="Pet photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pet_placeholder"
                        app:shapeAppearanceOverlay="@style/PawConnectRoundedLargeShape" />


                    <TextView
                        android:id="@+id/tvAddPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_sm"
                        android:padding="@dimen/paw_space_xs"
                        android:text="Change Photo"
                        android:textColor="@color/paw_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Basic details -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:text="Basic details"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:hint="Pet Name">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_md"
                android:text="Species"
                android:textAppearance="@style/Paw.Text.Label" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Paw.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xs">


                <Spinner
                    android:id="@+id/spinnerSpecies"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/paw_input_min_height"
                    android:paddingStart="@dimen/paw_space_md"
                    android:paddingEnd="@dimen/paw_space_md"
                    android:spinnerMode="dropdown" />

            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_md"
                android:hint="Breed">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBreed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_md"
                android:hint="Age in years">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_md"
                android:text="Gender"
                android:textAppearance="@style/Paw.Text.Label" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Paw.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xs">


                <Spinner
                    android:id="@+id/spinnerGender"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/paw_input_min_height"
                    android:paddingStart="@dimen/paw_space_md"
                    android:paddingEnd="@dimen/paw_space_md"
                    android:spinnerMode="dropdown" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Description -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:text="About your pet"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:hint="Description (optional)">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:minLines="3" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Paw.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:text="Save Changes" />


            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/paw_space_md"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/paw_primary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ===================================================== -->
    <!-- Initial Loading                                       -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEditPetLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditPet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            app:indicatorColor="@color/paw_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="Loading pet..."
            android:textAppearance="@style/Paw.Text.BodySecondary" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- Error                                                 -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEditPetError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditPet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to edit pet"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvEditPetError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:text="Please try again."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryEditPet"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>