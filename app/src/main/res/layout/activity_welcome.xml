<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/paw_screen_horizontal"
            android:paddingTop="@dimen/paw_space_3xl"
            android:paddingEnd="@dimen/paw_screen_horizontal"
            android:paddingBottom="@dimen/paw_space_2xl">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="104dp"
                android:layout_height="104dp"
                app:cardBackgroundColor="@color/paw_primary_container"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="PawConnect"
                    android:src="@drawable/ic_paw_auth" />

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:gravity="center"
                android:text="Welcome to PawConnect"
                android:textAlignment="center"
                android:textAppearance="@style/Paw.Text.Headline" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="A simple place for pet owners and veterinary professionals to connect and manage pet care."
                android:textAlignment="center"
                android:textAppearance="@style/Paw.Text.BodySecondary" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Paw.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_2xl">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/paw_space_lg">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pet owners"
                        android:textAppearance="@style/Paw.Text.Title" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_xxs"
                        android:text="Manage pets, discover veterinarians, request appointments and stay connected."
                        android:textAppearance="@style/Paw.Text.BodySecondary" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/paw_space_md"
                        android:layout_marginBottom="@dimen/paw_space_md"
                        android:background="@color/paw_divider" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Veterinarians"
                        android:textAppearance="@style/Paw.Text.Title" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_xxs"
                        android:text="Manage appointment requests, patients, messages and your professional profile."
                        android:textAppearance="@style/Paw.Text.BodySecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignUp"
                style="@style/Paw.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_2xl"
                android:text="Create Account" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Paw.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="I Already Have an Account" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>