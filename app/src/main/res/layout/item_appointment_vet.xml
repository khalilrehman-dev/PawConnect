<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Paw.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/paw_space_sm">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/paw_space_lg">


        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvPetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Pet"
                    android:textAppearance="@style/Paw.Text.Title" />


                <!--
                    Kept for legacy adapter compatibility.
                    New Fragment displays a simple request label.
                -->
                <TextView
                    android:id="@+id/tvOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Appointment request"
                    android:textAppearance="@style/Paw.Text.BodySecondary" />

            </LinearLayout>


            <com.google.android.material.chip.Chip
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_sm"
                android:clickable="false"
                android:focusable="false"
                android:text="Pending"
                android:textSize="12sp"
                app:chipMinHeight="32dp" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/paw_space_md"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:background="@color/paw_divider" />


        <!-- Schedule -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="18/8/2026"
                    android:textAppearance="@style/Paw.Text.Body" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="3:30 PM"
                    android:textAppearance="@style/Paw.Text.Body" />

            </LinearLayout>

        </LinearLayout>


        <!-- Note -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVetAppointmentNote"
            style="@style/Paw.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/paw_space_sm">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason for visit"
                    android:textAppearance="@style/Paw.Text.Caption" />


                <TextView
                    android:id="@+id/tvNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="Appointment note"
                    android:textAppearance="@style/Paw.Text.BodySecondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Actions -->

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Paw.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/paw_space_xs"
                android:layout_weight="1"
                android:text="Reject"
                android:textColor="@color/paw_error"
                app:strokeColor="@color/paw_error" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                style="@style/Paw.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_xs"
                android:layout_weight="1"
                android:text="Accept" />

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>