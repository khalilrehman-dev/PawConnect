<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <!-- Header -->

    <TextView
        android:id="@+id/tvPetsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xl"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="My Pets"
        android:textAppearance="@style/Paw.Text.Headline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvPetsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xxs"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="View and manage your pet profiles."
        android:textAppearance="@style/Paw.Text.BodySecondary"
        app:layout_constraintTop_toBottomOf="@id/tvPetsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Pet List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/paw_space_lg"
        android:clipToPadding="false"
        android:paddingStart="@dimen/paw_screen_horizontal"
        android:paddingEnd="@dimen/paw_screen_horizontal"
        android:paddingBottom="96dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvPetsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Loading -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressPets"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        app:indicatorColor="@color/paw_primary"
        app:layout_constraintTop_toBottomOf="@id/tvPetsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Empty State -->

    <LinearLayout
        android:id="@+id/layoutEmptyPets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvPetsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="No pets"
            android:src="@drawable/ic_nav_pets"
            app:tint="@color/paw_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="No pets yet"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:text="Add your first pet to keep its profile and veterinary appointments together."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyAddPet"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Add Pet"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/paw_space_xs" />

    </LinearLayout>


    <!-- Error State -->

    <LinearLayout
        android:id="@+id/layoutPetsError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvPetsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load pets"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvPetsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:text="Please try again."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryPets"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>


    <!-- Add Pet -->

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddPet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/paw_space_lg"
        android:layout_marginBottom="@dimen/paw_space_lg"
        android:text="Add Pet"
        android:textColor="@color/paw_on_primary"
        android:visibility="gone"
        app:backgroundTint="@color/paw_primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/paw_on_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>