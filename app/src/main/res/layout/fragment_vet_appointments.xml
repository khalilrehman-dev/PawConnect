<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <!-- Header -->

    <TextView
        android:id="@+id/tvVetAppointmentsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xl"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Appointments"
        android:textAppearance="@style/Paw.Text.Headline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvVetAppointmentsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xxs"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Review and manage appointment requests."
        android:textAppearance="@style/Paw.Text.BodySecondary"
        app:layout_constraintTop_toBottomOf="@id/tvVetAppointmentsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Filters -->

    <HorizontalScrollView
        android:id="@+id/scrollVetAppointmentFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paw_space_md"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvVetAppointmentsSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/paw_screen_horizontal"
            android:paddingEnd="@dimen/paw_screen_horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">


            <com.google.android.material.chip.Chip
                android:id="@+id/chipAllVetAppointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All" />


            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendingVetAppointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending" />


            <com.google.android.material.chip.Chip
                android:id="@+id/chipAcceptedVetAppointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accepted" />


            <com.google.android.material.chip.Chip
                android:id="@+id/chipClosedVetAppointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closed" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>


    <!-- List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVetAppointments"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/paw_space_sm"
        android:clipToPadding="false"
        android:paddingStart="@dimen/paw_screen_horizontal"
        android:paddingEnd="@dimen/paw_screen_horizontal"
        android:paddingBottom="@dimen/paw_space_xl"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollVetAppointmentFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Loading -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressVetAppointments"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        app:indicatorColor="@color/paw_primary"
        app:layout_constraintTop_toBottomOf="@id/scrollVetAppointmentFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Empty State -->

    <LinearLayout
        android:id="@+id/layoutVetAppointmentsEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollVetAppointmentFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="No appointments"
            android:src="@drawable/ic_nav_calendar"
            app:tint="@color/paw_primary" />


        <TextView
            android:id="@+id/tvVetAppointmentsEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="No appointments yet"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvVetAppointmentsEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:text="New appointment requests from pet owners will appear here."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />

    </LinearLayout>


    <!-- Error State -->

    <LinearLayout
        android:id="@+id/layoutVetAppointmentsError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollVetAppointmentFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load appointments"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvVetAppointmentsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:text="Please try again."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryVetAppointments"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>