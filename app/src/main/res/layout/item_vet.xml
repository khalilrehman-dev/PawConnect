<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Paw.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/paw_space_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/paw_space_md">


        <!-- Vet Photo -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivVetPhoto"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@color/paw_surface_variant"
            android:contentDescription="Veterinarian photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/PawConnectRoundedMediumShape" />


        <!-- Details -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/paw_space_md"
            android:layout_weight="1"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tvVetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dr. Name"
                    android:textAppearance="@style/Paw.Text.Title" />


                <TextView
                    android:id="@+id/tvAvailability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/paw_space_xs"
                    android:text="Available"
                    android:textColor="@color/paw_success"
                    android:textSize="12sp" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvClinicName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Clinic"
                android:textAppearance="@style/Paw.Text.BodySecondary" />


            <TextView
                android:id="@+id/tvCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="City"
                android:textAppearance="@style/Paw.Text.Caption" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tvSpecialization"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="General Practice"
                    android:textColor="@color/paw_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvYears"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/paw_space_xs"
                    android:text="5 yrs experience"
                    android:textAppearance="@style/Paw.Text.Caption" />

            </LinearLayout>

        </LinearLayout>


        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="@dimen/paw_space_xs"
            android:contentDescription="View veterinarian"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/paw_text_tertiary" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>