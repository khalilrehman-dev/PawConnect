<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPatients"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <!-- ===================================================== -->
    <!-- Header                                                -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvPatientsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xl"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Patients"
        android:textAppearance="@style/Paw.Text.Headline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvPatientsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xxs"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Pets with accepted appointments appear here."
        android:textAppearance="@style/Paw.Text.BodySecondary"
        app:layout_constraintTop_toBottomOf="@id/tvPatientsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Patient List                                          -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPatients"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/paw_space_lg"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="@dimen/paw_screen_horizontal"
        android:paddingEnd="@dimen/paw_screen_horizontal"
        android:paddingBottom="@dimen/paw_space_xl"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvPatientsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Loading State                                         -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutPatientsLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvPatientsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressPatients"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            app:indicatorColor="@color/paw_primary"
            app:trackColor="@color/paw_surface_variant" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="Loading patients..."
            android:textAppearance="@style/Paw.Text.BodySecondary" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- Empty State                                           -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutPatientsEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvPatientsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="@color/paw_primary_container"
            app:cardCornerRadius="44dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">


            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="No patients"
                android:src="@drawable/ic_nav_patients"
                app:tint="@color/paw_primary" />

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:gravity="center"
            android:text="No patients yet"
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Pets will appear here after you accept their appointment requests."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- Error State                                           -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutPatientsError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvPatientsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="@color/paw_error_container"
            app:cardCornerRadius="44dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">


            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:contentDescription="Unable to load patients"
                android:src="@drawable/ic_nav_patients"
                app:tint="@color/paw_error" />

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:gravity="center"
            android:text="Unable to load patients"
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvPatientsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Please try again."
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryPatients"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>