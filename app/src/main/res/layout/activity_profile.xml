<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/paw_screen_horizontal">


        <!-- ================================================= -->
        <!-- Profile Header                                    -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/paw_space_xl">


            <ImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@color/paw_surface_variant"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />


            <TextView
                android:id="@+id/tvChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:padding="@dimen/paw_space_xxs"
                android:text="Change Photo"
                android:textColor="@color/paw_primary"
                android:textStyle="bold"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="Name"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <TextView
                android:id="@+id/tvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xxs"
                android:text="Role"
                android:textAppearance="@style/Paw.Text.BodySecondary" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- View Mode                                         -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="@dimen/paw_space_lg">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textAppearance="@style/Paw.Text.Caption" />


            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/paw_space_md"
                android:layout_marginTop="@dimen/paw_space_xxs"
                android:text="email@example.com"
                android:textAppearance="@style/Paw.Text.Body" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textAppearance="@style/Paw.Text.Caption" />


            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xxs"
                android:text="Not set"
                android:textAppearance="@style/Paw.Text.Body" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Edit Mode                                         -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="@dimen/paw_space_lg"
            android:visibility="gone">


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/paw_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:hint="Phone Number">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/paw_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Actions                                           -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVetProfessionalProfile"
            style="@style/Paw.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/paw_space_sm"
            android:text="Professional Vet Profile"
            android:visibility="gone" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/paw_space_sm"
            android:text="Edit Profile" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/paw_space_sm"
            android:text="Save Changes"
            android:visibility="gone" />


        <!-- Logout -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Paw.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:layout_marginBottom="@dimen/paw_space_md"
            android:text="Log out"
            android:textColor="@color/paw_error"
            app:strokeColor="@color/paw_error" />


        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>