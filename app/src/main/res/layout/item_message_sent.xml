<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingTop="3dp"
    android:paddingEnd="@dimen/paw_space_md"
    android:paddingBottom="3dp">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_sent"
        android:orientation="vertical"
        android:paddingStart="@dimen/paw_space_md"
        android:paddingTop="@dimen/paw_space_sm"
        android:paddingEnd="@dimen/paw_space_md"
        android:paddingBottom="@dimen/paw_space_xs">


        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textColor="@color/paw_on_primary"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/paw_space_xxs"
            android:alpha="0.72"
            android:text="12:00 PM"
            android:textColor="@color/paw_on_primary"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>