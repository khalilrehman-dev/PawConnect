<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background"
    android:focusable="true"
    android:focusableInTouchMode="true">


    <!-- ===================================================== -->
    <!-- Toolbar                                               -->
    <!-- ===================================================== -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChat"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/paw_surface"
        app:title="Chat"
        app:titleTextColor="@color/paw_text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Main chat content                                     -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarChat"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageComposer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Realtime Messages -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingTop="@dimen/paw_space_md"
            android:paddingBottom="@dimen/paw_space_md"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- Opening / Loading                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutChatLoading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/paw_space_2xl"
            android:layout_marginEnd="@dimen/paw_space_2xl"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                app:indicatorColor="@color/paw_primary"
                app:trackColor="@color/paw_surface_variant" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_md"
                android:text="Opening conversation..."
                android:textAppearance="@style/Paw.Text.BodySecondary" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Genuine Empty Conversation                        -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutChatEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/paw_space_2xl"
            android:layout_marginEnd="@dimen/paw_space_2xl"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="@color/paw_primary_container"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="Conversation"
                    android:src="@drawable/ic_nav_messages"
                    app:tint="@color/paw_primary" />

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_lg"
                android:text="No messages yet"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xs"
                android:gravity="center"
                android:text="Send a message to start the conversation."
                android:textAlignment="center"
                android:textAppearance="@style/Paw.Text.BodySecondary" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Real Error                                        -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutChatError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/paw_space_2xl"
            android:layout_marginEnd="@dimen/paw_space_2xl"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="@color/paw_error_container"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="Conversation error"
                    android:src="@drawable/ic_nav_messages"
                    app:tint="@color/paw_error" />

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_lg"
                android:text="Unable to open conversation"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <TextView
                android:id="@+id/tvChatError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xs"
                android:gravity="center"
                android:text="Please try again."
                android:textAlignment="center"
                android:textAppearance="@style/Paw.Text.BodySecondary" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryChat"
                style="@style/Paw.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_lg"
                android:text="Try Again" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- Message composer                                      -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutMessageComposer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/paw_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="@dimen/paw_elevation_medium"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/paw_space_md"
            android:paddingTop="@dimen/paw_space_sm"
            android:paddingEnd="@dimen/paw_space_md"
            android:paddingBottom="@dimen/paw_space_sm">


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paw.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="Type a message..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="52dp"
                    android:textColor="@color/paw_text_primary"
                    android:textColorHint="@color/paw_text_tertiary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_sm"
                android:contentDescription="Send message"
                android:src="@drawable/ic_send"
                app:backgroundTint="@color/paw_primary"
                app:fabCustomSize="52dp"
                app:maxImageSize="24dp"
                app:tint="@color/paw_on_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>