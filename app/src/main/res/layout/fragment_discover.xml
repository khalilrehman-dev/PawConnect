<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <!-- ===================================================== -->
    <!-- Header                                                -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvDiscoverTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xl"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Discover"
        android:textAppearance="@style/Paw.Text.Headline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvDiscoverSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xxs"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Find veterinary care and explore pet profiles."
        android:textAppearance="@style/Paw.Text.BodySecondary"
        app:layout_constraintTop_toBottomOf="@id/tvDiscoverTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Find Vet Card                                         -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFindVet"
        style="@style/Paw.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_lg"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvDiscoverSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/paw_space_md">


            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Find veterinarian"
                android:src="@drawable/ic_nav_discover"
                app:tint="@color/paw_primary" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/paw_space_md"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find a veterinarian"
                    android:textAppearance="@style/Paw.Text.Title" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/paw_space_xxs"
                    android:text="Search by name, clinic, city or specialization."
                    android:textAppearance="@style/Paw.Text.BodySecondary" />

            </LinearLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindVet"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Open veterinarians"
                app:icon="@drawable/ic_chevron_right"
                app:iconTint="@color/paw_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- Pets heading                                          -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvDiscoverPetsHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_xl"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:text="Pet profiles"
        android:textAppearance="@style/Paw.Text.TitleLarge"
        app:layout_constraintTop_toBottomOf="@id/cardFindVet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Search                                                -->
    <!-- ===================================================== -->

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchDiscover"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/paw_screen_horizontal"
        android:layout_marginTop="@dimen/paw_space_sm"
        android:layout_marginEnd="@dimen/paw_screen_horizontal"
        android:background="@color/paw_surface"
        android:queryHint="Search pets or breeds"
        app:iconifiedByDefault="false"
        app:layout_constraintTop_toBottomOf="@id/tvDiscoverPetsHeading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Species Filter                                        -->
    <!-- ===================================================== -->

    <HorizontalScrollView
        android:id="@+id/scrollSpecies"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paw_space_xs"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/searchDiscover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSpecies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/paw_screen_horizontal"
            android:paddingEnd="@dimen/paw_screen_horizontal"
            app:selectionRequired="true"
            app:singleSelection="true" />

    </HorizontalScrollView>


    <!-- ===================================================== -->
    <!-- Pet Results                                           -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDiscoverPets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/paw_space_sm"
        android:clipToPadding="false"
        android:paddingStart="@dimen/paw_space_sm"
        android:paddingEnd="@dimen/paw_space_sm"
        android:paddingBottom="@dimen/paw_space_xl"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollSpecies"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Loading                                               -->
    <!-- ===================================================== -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressDiscover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        app:indicatorColor="@color/paw_primary"
        app:layout_constraintTop_toBottomOf="@id/scrollSpecies"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- Empty                                                -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutDiscoverEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollSpecies"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="No pets found"
            android:src="@drawable/ic_nav_pets"
            app:tint="@color/paw_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_md"
            android:text="No pets found"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvDiscoverEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- Error                                                 -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutDiscoverError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/paw_space_2xl"
        android:layout_marginEnd="@dimen/paw_space_2xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollSpecies"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load Discover"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvDiscoverError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryDiscover"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>