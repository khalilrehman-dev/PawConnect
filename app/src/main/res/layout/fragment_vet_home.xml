<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">


    <!-- ===================================================== -->
    <!-- Main Content                                          -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/paw_screen_horizontal"
            android:paddingTop="@dimen/paw_space_xl"
            android:paddingEnd="@dimen/paw_screen_horizontal"
            android:paddingBottom="@dimen/paw_space_2xl">


            <!-- ================================================= -->
            <!-- Header                                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hello, Doctor"
                        android:textAppearance="@style/Paw.Text.Headline" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paw_space_xxs"
                        android:text="Here’s what needs your attention today."
                        android:textAppearance="@style/Paw.Text.BodySecondary" />

                </LinearLayout>


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="@dimen/paw_avatar_medium"
                    android:layout_height="@dimen/paw_avatar_medium"
                    android:layout_marginStart="@dimen/paw_space_md"
                    android:background="@color/paw_surface_variant"
                    android:clickable="true"
                    android:contentDescription="Open profile"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile"
                    app:shapeAppearanceOverlay="@style/PawConnectCircleShape" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- Professional Profile Reminder                     -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileReminder"
                style="@style/Paw.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_xl"
                android:visibility="gone">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/paw_space_lg">


                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Professional profile"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/paw_primary" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/paw_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Complete your professional profile"
                            android:textAppearance="@style/Paw.Text.Title" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_xxs"
                            android:text="Add your clinic, specialization and experience."
                            android:textAppearance="@style/Paw.Text.BodySecondary" />

                    </LinearLayout>

                </LinearLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompleteProfile"
                    style="@style/Paw.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/paw_space_lg"
                    android:layout_marginEnd="@dimen/paw_space_lg"
                    android:layout_marginBottom="@dimen/paw_space_lg"
                    android:text="Complete profile" />

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- Overview                                         -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_2xl"
                android:text="Overview"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:orientation="horizontal">


                <!-- Pending requests -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPending"
                    style="@style/Paw.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/paw_space_md">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Pending appointments"
                            android:src="@drawable/ic_nav_calendar"
                            app:tint="@color/paw_primary" />


                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_md"
                            android:text="0"
                            android:textAppearance="@style/Paw.Text.TitleLarge" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_xxs"
                            android:text="Pending requests"
                            android:textAppearance="@style/Paw.Text.BodySecondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <Space
                    android:layout_width="@dimen/paw_space_sm"
                    android:layout_height="1dp" />


                <!-- Patients -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPatients"
                    style="@style/Paw.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/paw_space_md">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Patients"
                            android:src="@drawable/ic_nav_patients"
                            app:tint="@color/paw_primary" />


                        <TextView
                            android:id="@+id/tvPatientCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_md"
                            android:text="0"
                            android:textAppearance="@style/Paw.Text.TitleLarge" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_xxs"
                            android:text="Patients"
                            android:textAppearance="@style/Paw.Text.BodySecondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- Messages -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMessages"
                style="@style/Paw.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/paw_space_md">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Messages"
                        android:src="@drawable/ic_nav_messages"
                        app:tint="@color/paw_primary" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/paw_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Messages"
                            android:textAppearance="@style/Paw.Text.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_xxs"
                            android:text="Unread conversations"
                            android:textAppearance="@style/Paw.Text.BodySecondary" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvUnreadCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/Paw.Text.TitleLarge"
                        android:textColor="@color/paw_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- Next Appointment                                  -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_2xl"
                android:text="Next appointment"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextAppointment"
                style="@style/Paw.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/paw_space_lg">


                    <!-- Appointment exists -->

                    <LinearLayout
                        android:id="@+id/layoutAppointmentDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tvAppointmentPet"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Patient"
                                android:textAppearance="@style/Paw.Text.Title" />


                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAppointmentStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:text="Pending"
                                android:textSize="12sp"
                                app:chipMinHeight="32dp" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/tvAppointmentDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_sm"
                            android:textAppearance="@style/Paw.Text.BodySecondary" />


                        <TextView
                            android:id="@+id/tvAppointmentNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_xs"
                            android:textAppearance="@style/Paw.Text.Body"
                            android:visibility="gone" />

                    </LinearLayout>


                    <!-- No upcoming appointment -->

                    <LinearLayout
                        android:id="@+id/layoutNoAppointment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No upcoming appointments"
                            android:textAppearance="@style/Paw.Text.Title" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/paw_space_xs"
                            android:text="New or accepted appointments will appear here."
                            android:textAppearance="@style/Paw.Text.BodySecondary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- Quick Actions                                     -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_2xl"
                android:text="Quick actions"
                android:textAppearance="@style/Paw.Text.TitleLarge" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAppointments"
                style="@style/Paw.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="View appointments"
                app:icon="@drawable/ic_nav_calendar"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/paw_space_xs" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfessionalProfile"
                style="@style/Paw.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paw_space_sm"
                android:text="Professional profile"
                app:icon="@drawable/ic_nav_profile"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/paw_space_xs" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ===================================================== -->
    <!-- Loading                                               -->
    <!-- ===================================================== -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/paw_primary" />


    <!-- ===================================================== -->
    <!-- Error State                                           -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutHomeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/paw_space_xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load Home"
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.TitleLarge" />


        <TextView
            android:id="@+id/tvHomeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_xs"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/Paw.Text.BodySecondary" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryHome"
            style="@style/Paw.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/paw_space_lg"
            android:text="Try Again" />

    </LinearLayout>

</FrameLayout>