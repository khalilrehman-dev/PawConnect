<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- ===================================================== -->
    <!-- Typography                                            -->
    <!-- ===================================================== -->

    <style
        name="Paw.Text.Display"
        parent="TextAppearance.Material3.HeadlineLarge">

        <item name="android:textColor">
            @color/paw_text_primary
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

        <item name="android:textStyle">
            normal
        </item>

    </style>


    <style
        name="Paw.Text.Headline"
        parent="TextAppearance.Material3.HeadlineSmall">

        <item name="android:textColor">
            @color/paw_text_primary
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>


    <style
        name="Paw.Text.TitleLarge"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="android:textColor">
            @color/paw_text_primary
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>


    <style
        name="Paw.Text.Title"
        parent="TextAppearance.Material3.TitleMedium">

        <item name="android:textColor">
            @color/paw_text_primary
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>


    <style
        name="Paw.Text.Body"
        parent="TextAppearance.Material3.BodyLarge">

        <item name="android:textColor">
            @color/paw_text_primary
        </item>

    </style>


    <style
        name="Paw.Text.BodySecondary"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">
            @color/paw_text_secondary
        </item>

    </style>


    <style
        name="Paw.Text.Caption"
        parent="TextAppearance.Material3.BodySmall">

        <item name="android:textColor">
            @color/paw_text_tertiary
        </item>

    </style>


    <style
        name="Paw.Text.Label"
        parent="TextAppearance.Material3.LabelLarge">

        <item name="android:textColor">
            @color/paw_text_primary
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>


    <!-- ===================================================== -->
    <!-- Buttons                                               -->
    <!-- ===================================================== -->

    <style
        name="Paw.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">
            @dimen/paw_button_height
        </item>

        <item name="android:textAllCaps">
            false
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

        <item name="cornerRadius">
            @dimen/paw_radius_medium
        </item>

        <item name="backgroundTint">
            @color/paw_primary
        </item>

        <item name="android:textColor">
            @color/paw_on_primary
        </item>

    </style>


    <style
        name="Paw.Button.Secondary"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:minHeight">
            @dimen/paw_button_height
        </item>

        <item name="android:textAllCaps">
            false
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

        <item name="cornerRadius">
            @dimen/paw_radius_medium
        </item>

        <item name="strokeColor">
            @color/paw_outline_variant
        </item>

        <item name="android:textColor">
            @color/paw_primary
        </item>

    </style>


    <style
        name="Paw.Button.Tonal"
        parent="Widget.Material3.Button.TonalButton">

        <item name="android:minHeight">
            @dimen/paw_button_height
        </item>

        <item name="android:textAllCaps">
            false
        </item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

        <item name="cornerRadius">
            @dimen/paw_radius_medium
        </item>

    </style>


    <!-- ===================================================== -->
    <!-- Cards                                                 -->
    <!-- ===================================================== -->

    <style
        name="Paw.Card"
        parent="Widget.Material3.CardView.Elevated">

        <item name="cardCornerRadius">
            @dimen/paw_radius_large
        </item>

        <item name="cardElevation">
            @dimen/paw_elevation_small
        </item>

        <item name="cardBackgroundColor">
            @color/paw_surface
        </item>

        <item name="strokeColor">
            @color/paw_outline_variant
        </item>

        <item name="strokeWidth">
            1dp
        </item>

    </style>


    <style
        name="Paw.Card.Flat"
        parent="Widget.Material3.CardView.Filled">

        <item name="cardCornerRadius">
            @dimen/paw_radius_large
        </item>

        <item name="cardElevation">
            0dp
        </item>

        <item name="cardBackgroundColor">
            @color/paw_surface_soft
        </item>

    </style>


    <!-- ===================================================== -->
    <!-- Text Input                                            -->
    <!-- ===================================================== -->

    <style
        name="Paw.TextInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxCornerRadiusTopStart">
            @dimen/paw_radius_medium
        </item>

        <item name="boxCornerRadiusTopEnd">
            @dimen/paw_radius_medium
        </item>

        <item name="boxCornerRadiusBottomStart">
            @dimen/paw_radius_medium
        </item>

        <item name="boxCornerRadiusBottomEnd">
            @dimen/paw_radius_medium
        </item>

        <item name="boxStrokeColor">
            @color/paw_primary
        </item>

        <item name="hintTextColor">
            @color/paw_text_secondary
        </item>

        <item name="android:textColorHint">
            @color/paw_text_secondary
        </item>

    </style>


    <!-- ===================================================== -->
    <!-- Shape Overlays                                        -->
    <!-- ===================================================== -->

    <style name="PawConnectCircleShape">

        <item name="cornerFamily">
            rounded
        </item>

        <item name="cornerSize">
            50%
        </item>

    </style>


    <style name="PawConnectRoundedMediumShape">

        <item name="cornerFamily">
            rounded
        </item>

        <item name="cornerSize">
            @dimen/paw_radius_medium
        </item>

    </style>


    <style name="PawConnectRoundedLargeShape">

        <item name="cornerFamily">
            rounded
        </item>

        <item name="cornerSize">
            @dimen/paw_radius_large
        </item>

    </style>

</resources>