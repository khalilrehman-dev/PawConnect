rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Common helpers
    // ─────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() &&
        request.auth.uid == uid;
    }

    function userExists(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)
      );
    }

    function isVetAccount(uid) {
      return userExists(uid) &&
        get(
          /databases/$(database)/documents/users/$(uid)
        ).data.role == "veterinarian";
    }

    function slotId(vetId, scheduledAt) {
      return vetId + "_" + string(scheduledAt);
    }

    function slotExistsAfter(vetId, scheduledAt) {
      let id = slotId(vetId, scheduledAt);

      return existsAfter(
        /databases/$(database)/documents/appointmentSlots/$(id)
      );
    }


    // ═════════════════════════════════════════════
    // USERS
    // ═════════════════════════════════════════════

    match /users/{userId} {

      /*
       * Current PawConnect code reads other users'
       * display names for chat/patient screens.
       *
       * Therefore signed-in users currently require
       * document read access.
       *
       * Later we should split public identity from
       * private account data before final release.
       */
      allow read: if signedIn();

      allow create: if
        isSelf(userId) &&

        request.resource.data.keys().hasAll([
          "uid",
          "displayName",
          "email",
          "phoneNumber",
          "profileImageUrl",
          "role",
          "isEmailVerified",
          "createdAt"
        ]) &&

        request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "phoneNumber",
          "profileImageUrl",
          "role",
          "isEmailVerified",
          "createdAt"
        ]) &&

        request.resource.data.uid == userId &&

        request.resource.data.role in [
          "pet_owner",
          "veterinarian"
        ] &&

        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.profileImageUrl is string &&
        request.resource.data.isEmailVerified is bool &&
        request.resource.data.createdAt is int;

      allow update: if
        isSelf(userId) &&

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "displayName",
            "phoneNumber",
            "profileImageUrl",
            "isEmailVerified"
          ]) &&

        request.resource.data.uid ==
          resource.data.uid &&

        request.resource.data.role ==
          resource.data.role &&

        request.resource.data.email ==
          resource.data.email &&

        request.resource.data.createdAt ==
          resource.data.createdAt;

      allow delete: if false;
    }


    // ═════════════════════════════════════════════
    // VETERINARIAN PUBLIC PROFILES
    // ═════════════════════════════════════════════

    match /vets/{vetId} {

      allow read: if signedIn();

      allow create: if
        isSelf(vetId) &&
        isVetAccount(vetId) &&

        request.resource.data.keys().hasAll([
          "uid",
          "displayName",
          "clinicName",
          "city",
          "address",
          "phoneNumber",
          "specialization",
          "yearsOfExperience",
          "profileImageUrl",
          "isAvailable",
          "createdAt"
        ]) &&

        request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "clinicName",
          "city",
          "address",
          "phoneNumber",
          "specialization",
          "yearsOfExperience",
          "profileImageUrl",
          "isAvailable",
          "createdAt"
        ]) &&

        request.resource.data.uid == vetId &&

        request.resource.data.yearsOfExperience is int &&
        request.resource.data.yearsOfExperience >= 0 &&

        request.resource.data.isAvailable is bool &&
        request.resource.data.createdAt is int;

      allow update: if
        isSelf(vetId) &&
        isVetAccount(vetId) &&

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "displayName",
            "clinicName",
            "city",
            "address",
            "phoneNumber",
            "specialization",
            "yearsOfExperience",
            "profileImageUrl",
            "isAvailable"
          ]) &&

        request.resource.data.uid ==
          resource.data.uid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;

      allow delete: if false;
    }


    // ═════════════════════════════════════════════
    // PETS
    // ═════════════════════════════════════════════

    match /pets/{petId} {

      /*
       * Discover currently shows pets from other users,
       * so signed-in users may read pet profiles.
       */
      allow read: if signedIn();

      allow create: if
        signedIn() &&

        request.resource.data.keys().hasAll([
          "id",
          "ownerId",
          "name",
          "species",
          "breed",
          "age",
          "gender",
          "description",
          "imageUrl",
          "createdAt"
        ]) &&

        request.resource.data.keys().hasOnly([
          "id",
          "ownerId",
          "name",
          "species",
          "breed",
          "age",
          "gender",
          "description",
          "imageUrl",
          "createdAt"
        ]) &&

        request.resource.data.id == petId &&
        request.resource.data.ownerId == request.auth.uid &&

        request.resource.data.name is string &&
        request.resource.data.species is string &&
        request.resource.data.breed is string &&
        request.resource.data.age is int &&
        request.resource.data.age >= 0 &&
        request.resource.data.gender is string &&
        request.resource.data.description is string &&
        request.resource.data.imageUrl is string &&
        request.resource.data.createdAt is int;

      allow update: if
        signedIn() &&
        resource.data.ownerId == request.auth.uid &&

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "name",
            "species",
            "breed",
            "age",
            "gender",
            "description",
            "imageUrl"
          ]) &&

        request.resource.data.id ==
          resource.data.id &&

        request.resource.data.ownerId ==
          resource.data.ownerId &&

        request.resource.data.createdAt ==
          resource.data.createdAt;

      allow delete: if
        signedIn() &&
        resource.data.ownerId == request.auth.uid;
    }


    // ═════════════════════════════════════════════
    // APPOINTMENTS
    // ═════════════════════════════════════════════

    match /appointments/{appointmentId} {

      function validNewAppointment() {

        let data =
          request.resource.data;

        let pet =
          get(
            /databases/$(database)/documents/pets/$(data.petId)
          );

        let vet =
          get(
            /databases/$(database)/documents/vets/$(data.vetId)
          );

        let sid =
          data.vetId + "_" + string(data.scheduledAt);

        let slot =
          getAfter(
            /databases/$(database)/documents/appointmentSlots/$(sid)
          );

        return
          signedIn() &&

          data.keys().hasAll([
            "id",
            "petOwnerId",
            "vetId",
            "vetName",
            "clinicName",
            "petId",
            "petName",
            "date",
            "time",
            "scheduledAt",
            "note",
            "status",
            "createdAt"
          ]) &&

          data.keys().hasOnly([
            "id",
            "petOwnerId",
            "vetId",
            "vetName",
            "clinicName",
            "petId",
            "petName",
            "date",
            "time",
            "scheduledAt",
            "note",
            "status",
            "createdAt"
          ]) &&

          data.id == appointmentId &&

          data.petOwnerId ==
            request.auth.uid &&

          data.status ==
            "pending" &&

          data.scheduledAt is int &&
          data.scheduledAt > 0 &&

          data.createdAt is int &&

          pet != null &&
          vet != null &&
          slot != null &&

          pet.data.ownerId ==
            request.auth.uid &&

          data.petName ==
            pet.data.name &&

          data.vetName ==
            vet.data.displayName &&

          data.clinicName ==
            vet.data.clinicName &&

          slot.data.appointmentId ==
            appointmentId &&

          slot.data.vetId ==
            data.vetId &&

          slot.data.scheduledAt ==
            data.scheduledAt;
      }


      function validStatusChange() {

        let changed =
          request.resource.data
            .diff(resource.data)
            .affectedKeys();

        let nextStatus =
          request.resource.data.status;

        let scheduledAt =
          resource.data.get(
            "scheduledAt",
            0
          );

        return
          changed.hasOnly([
            "status"
          ]) &&

          (

            // Vet accepts pending appointment.
            (
              request.auth.uid ==
                resource.data.vetId &&

              resource.data.status ==
                "pending" &&

              nextStatus ==
                "accepted" &&

              (
                scheduledAt == 0 ||
                slotExistsAfter(
                  resource.data.vetId,
                  scheduledAt
                )
              )
            )

            ||

            // Vet rejects — slot must be removed.
            (
              request.auth.uid ==
                resource.data.vetId &&

              resource.data.status ==
                "pending" &&

              nextStatus ==
                "rejected" &&

              (
                scheduledAt == 0 ||
                !slotExistsAfter(
                  resource.data.vetId,
                  scheduledAt
                )
              )
            )

            ||

            // Owner cancels — slot must be removed.
            (
              request.auth.uid ==
                resource.data.petOwnerId &&

              (
                resource.data.status ==
                  "pending" ||

                resource.data.status ==
                  "accepted"
              ) &&

              nextStatus ==
                "cancelled" &&

              (
                scheduledAt == 0 ||
                !slotExistsAfter(
                  resource.data.vetId,
                  scheduledAt
                )
              )
            )
          );
      }


      allow create: if
        validNewAppointment();

      /*
       * Owner query must use:
       * whereEqualTo("petOwnerId", currentUid)
       *
       * Vet query must use:
       * whereEqualTo("vetId", currentUid)
       */
      allow read: if
        signedIn() &&

        (
          resource.data.petOwnerId ==
            request.auth.uid ||

          resource.data.vetId ==
            request.auth.uid
        );

      allow update: if
        signedIn() &&
        validStatusChange();

      allow delete: if false;
    }


    // ═════════════════════════════════════════════
    // APPOINTMENT SLOT LOCKS
    // ═════════════════════════════════════════════

    match /appointmentSlots/{slotDocumentId} {

      function validSlotCreate() {

        let data =
          request.resource.data;

        let appointment =
          getAfter(
            /databases/$(database)/documents/appointments/$(data.appointmentId)
          );

        return
          signedIn() &&

          data.keys().hasAll([
            "appointmentId",
            "vetId",
            "scheduledAt",
            "createdAt"
          ]) &&

          data.keys().hasOnly([
            "appointmentId",
            "vetId",
            "scheduledAt",
            "createdAt"
          ]) &&

          data.scheduledAt is int &&
          data.createdAt is int &&

          slotDocumentId ==
            data.vetId +
            "_" +
            string(data.scheduledAt) &&

          appointment != null &&

          appointment.data.id ==
            data.appointmentId &&

          appointment.data.petOwnerId ==
            request.auth.uid &&

          appointment.data.vetId ==
            data.vetId &&

          appointment.data.scheduledAt ==
            data.scheduledAt &&

          appointment.data.status ==
            "pending";
      }


      function validSlotDelete() {

        let appointment =
          getAfter(
            /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
          );

        return
          signedIn() &&
          appointment != null &&

          appointment.data.vetId ==
            resource.data.vetId &&

          appointment.data.get(
            "scheduledAt",
            0
          ) ==
            resource.data.scheduledAt &&

          (

            (
              appointment.data.status ==
                "rejected" &&

              request.auth.uid ==
                appointment.data.vetId
            )

            ||

            (
              appointment.data.status ==
                "cancelled" &&

              request.auth.uid ==
                appointment.data.petOwnerId
            )
          );
      }


      /*
       * Booking transaction first checks whether
       * this deterministic slot document exists.
       */
      allow get: if signedIn();

      allow list: if false;

      allow create: if
        validSlotCreate();

      allow update: if false;

      allow delete: if
        validSlotDelete();
    }


    // ═════════════════════════════════════════════
    // CHATS
    // ═════════════════════════════════════════════

    match /chats/{chatId} {

      function validChatCreate() {

        let data =
          request.resource.data;

        let participants =
          data.participants;

        return
          signedIn() &&

          data.keys().hasAll([
            "chatId",
            "participants",
            "lastMessage",
            "lastMessageTime",
            "lastMessageSenderId",
            "unreadBy"
          ]) &&

          data.keys().hasOnly([
            "chatId",
            "participants",
            "lastMessage",
            "lastMessageTime",
            "lastMessageSenderId",
            "unreadBy"
          ]) &&

          data.chatId ==
            chatId &&

          participants is list &&
          participants.size() == 2 &&

          participants[0] !=
            participants[1] &&

          request.auth.uid in
            participants &&

          userExists(
            participants[0]
          ) &&

          userExists(
            participants[1]
          ) &&

          (
            (
              participants[0] <
                participants[1] &&

              chatId ==
                participants[0] +
                "_" +
                participants[1]
            )

            ||

            (
              participants[1] <
                participants[0] &&

              chatId ==
                participants[1] +
                "_" +
                participants[0]
            )
          ) &&

          data.lastMessage ==
            "" &&

          data.lastMessageTime ==
            0 &&

          data.lastMessageSenderId ==
            "" &&

          data.unreadBy is list &&
          data.unreadBy.size() ==
            0;
      }


      function validMessagePreviewUpdate() {

        let changed =
          request.resource.data
            .diff(resource.data)
            .affectedKeys();

        return
          changed.hasOnly([
            "lastMessage",
            "lastMessageTime",
            "lastMessageSenderId",
            "unreadBy"
          ]) &&

          request.resource.data.lastMessage
            is string &&

          request.resource.data.lastMessage
            .trim()
            .size() > 0 &&

          request.resource.data.lastMessage
            .size() <= 4000 &&

          request.resource.data.lastMessageSenderId ==
            request.auth.uid &&

          request.resource.data.lastMessageTime
            is int &&

          request.resource.data.lastMessageTime >=
            resource.data.lastMessageTime &&

          request.resource.data.unreadBy
            is list &&

          request.resource.data.unreadBy
            .size() == 1 &&

          request.resource.data.unreadBy[0]
            in resource.data.participants &&

          request.resource.data.unreadBy[0] !=
            request.auth.uid;
      }


      function validReadUpdate() {

        let changed =
          request.resource.data
            .diff(resource.data)
            .affectedKeys();

        return
          changed.hasOnly([
            "unreadBy"
          ]) &&

          resource.data.unreadBy
            is list &&

          request.resource.data.unreadBy
            is list &&

          request.auth.uid
            in resource.data.unreadBy &&

          request.resource.data.unreadBy ==
            resource.data.unreadBy.removeAll([
              request.auth.uid
            ]);
      }


      allow create: if
        validChatCreate();

      allow read: if
        signedIn() &&
        resource.data.participants is list &&
        request.auth.uid in
          resource.data.participants;

      allow update: if
        signedIn() &&

        request.auth.uid in
          resource.data.participants &&

        request.resource.data.chatId ==
          resource.data.chatId &&

        request.resource.data.participants ==
          resource.data.participants &&

        (
          validMessagePreviewUpdate() ||
          validReadUpdate()
        );

      allow delete: if false;
    }


    // ═════════════════════════════════════════════
    // CHAT MESSAGES
    //
    // Actual path:
    // messages/{chatId}/messages/{messageId}
    // ═════════════════════════════════════════════

    match /messages/{chatId}/messages/{messageId} {

      function validMessageCreate() {

        let data =
          request.resource.data;

        let chat =
          getAfter(
            /databases/$(database)/documents/chats/$(chatId)
          );

        return
          signedIn() &&
          chat != null &&

          data.keys().hasAll([
            "id",
            "chatId",
            "senderId",
            "text",
            "timestamp"
          ]) &&

          data.keys().hasOnly([
            "id",
            "chatId",
            "senderId",
            "text",
            "timestamp"
          ]) &&

          data.id ==
            messageId &&

          data.chatId ==
            chatId &&

          data.senderId ==
            request.auth.uid &&

          data.text is string &&

          data.text.trim().size() >
            0 &&

          data.text.size() <=
            4000 &&

          data.timestamp is int &&

          request.auth.uid in
            chat.data.participants &&

          chat.data.lastMessage ==
            data.text &&

          chat.data.lastMessageSenderId ==
            request.auth.uid &&

          chat.data.lastMessageTime ==
            data.timestamp &&

          chat.data.unreadBy
            is list &&

          chat.data.unreadBy.size() ==
            1 &&

          chat.data.unreadBy[0] !=
            request.auth.uid;
      }


      allow read: if
        signedIn() &&

        request.auth.uid in
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;

      allow create: if
        validMessageCreate();

      allow update, delete: if false;
    }


    // ═════════════════════════════════════════════
    // EVERYTHING ELSE
    // ═════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}